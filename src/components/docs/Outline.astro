---
interface Props {
  purpose: string;
  headings: string[];
}
const { purpose, headings } = Astro.props;
---

<section class="outline">
  <p class="outline-status">Coming with artic 0.1</p>
  <p class="outline-purpose">{purpose}</p>
  <p class="outline-lead">This page will cover:</p>
  <ul>
    {headings.map((h) => <li>{h}</li>)}
  </ul>
</section>

<style>
  .outline {
    border: 1px dashed var(--peri);
    border-radius: 4px;
    padding: 1rem 1.25rem;
    background: var(--panel);
  }
  .outline-status {
    margin: 0 0 0.5rem;
    color: var(--peri);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .outline-purpose {
    margin: 0 0 0.75rem;
    color: var(--line);
  }
  .outline-lead {
    margin: 0 0 0.25rem;
    color: var(--mute);
  }
  ul {
    margin: 0;
    color: var(--mute);
  }
</style>
