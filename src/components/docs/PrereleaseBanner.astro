---
// One place for the banner markup: later plugins append their own banners here.
import VersionBanner from 'starlight-versions/components/VersionBanner.astro';
---

<div class="prerelease-banner">
  <p>
    artic is pre-release. Things change fast; see the <a href="/#roadmap">roadmap</a>.
  </p>
</div>
<VersionBanner />

<style>
  .prerelease-banner {
    border: 1px dashed var(--peri);
    border-radius: 6px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    padding: 0.5rem 0.9rem;
    /* Inset like the text column below it, with room under the header. */
    margin: 1rem var(--sl-content-pad-x) 0;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .prerelease-banner p {
    margin: 0;
  }
  :global([data-theme='light']) .prerelease-banner {
    border-color: var(--sl-color-accent);
  }
  .prerelease-banner a {
    color: var(--peri);
    text-underline-offset: 0.2em;
  }
  :global([data-theme='light']) .prerelease-banner a {
    color: var(--sl-color-accent);
  }
  .prerelease-banner a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
</style>
