---
import { codeToHtml } from 'shiki';
import CodeTabs from './CodeTabs';
import CopyButton from './CopyButton';
import { COMMANDS, MAIN_XAML, VM_RS, articTheme } from './samples';

// The text the writer edits in the demo: highlighted like a live edit.
const editedLine = MAIN_XAML.split('\n').findIndex((l) => l.includes('"Hello, artic"'));
const editedFrom = MAIN_XAML.split('\n')[editedLine].indexOf('"Hello, artic"');

const [xamlHtml, rustHtml] = await Promise.all([
  codeToHtml(MAIN_XAML, {
    lang: 'xml',
    theme: articTheme,
    decorations: [
      {
        start: { line: editedLine, character: editedFrom },
        end: { line: editedLine, character: editedFrom + '"Hello, artic"'.length },
        properties: { class: 'edit' },
      },
    ],
  }),
  codeToHtml(VM_RS, { lang: 'rust', theme: articTheme }),
]);

const tabs = [
  {
    id: 'xaml',
    label: 'src/views/main.xaml',
    html: xamlHtml,
    hint: 'Change this text and save. The window updates while it runs.',
  },
  {
    id: 'rust',
    label: 'src/vm.rs',
    html: rustHtml,
    hint: "Logic is plain Rust. A binding to a name that doesn't exist fails the build.",
  },
];
---

<section id="get-started" class="gs" aria-labelledby="get-started-title">
  <div class="container wrap">
    <div class="steps">
      <h2 id="get-started-title">Your first window in a few minutes.</h2>
      <p class="one">The template is a small working app. Change it, and watch the window follow.</p>
      <ol>
        <li class="skip">
          <h3>Install Rust</h3>
          <p>Skip this if <code>cargo --version</code> already works.</p>
          <div class="os">
            <span class="on">macOS / Linux</span>
            <a href="https://rustup.rs">Windows</a>
          </div>
          <div class="cmd">
            <code>{COMMANDS.rustup}</code>
            <CopyButton client:load text={COMMANDS.rustup} />
          </div>
        </li>
        <li>
          <h3>Install the artic CLI</h3>
          <p>It creates projects and checks your XAML.</p>
          <div class="cmd">
            <code>{COMMANDS.install}</code>
            <CopyButton client:load text={COMMANDS.install} />
          </div>
        </li>
        <li>
          <h3>Create and run an app</h3>
          <p>Hot reload is on, so edits show up without a rebuild.</p>
          <div class="cmd">
            <code>{COMMANDS.create}</code>
            <CopyButton client:load text={COMMANDS.create} />
          </div>
          <div class="cmd">
            <code>{COMMANDS.run}</code>
            <CopyButton client:load text={COMMANDS.run} />
          </div>
        </li>
      </ol>
      <p class="pre">
        <strong>Pre-release.</strong> The CLI commands land with 0.1. Until then, the steps above show
        the planned flow.
      </p>
    </div>

    <div class="result">
      <CodeTabs client:visible tabs={tabs}>
        <div class="window" aria-hidden="true">
          <div class="bar"><i></i><i></i><i></i><span>hello</span></div>
          <div class="body">
            <div class="hi">Hello, artic</div>
            <div class="btn">Click me</div>
            <div class="count">Clicked 3 times</div>
          </div>
        </div>
      </CodeTabs>
    </div>

    <div class="next">
      <a href="/docs/tutorial/">Read the tutorial</a>
      <a href="/docs/start-here/examples/">Browse examples</a>
    </div>
  </div>
</section>

<style is:global>
  .gs {
    padding: 88px 0 104px;
  }
  .gs .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 72px;
    align-items: start;
  }
  .gs .steps,
  .gs .result {
    min-width: 0;
  }
  .gs h2 {
    margin: 0 0 14px;
    font: 700 clamp(34px, 4.2vw, 52px) / 1.02 var(--font-display);
  }
  .gs .one {
    margin: 0 0 40px;
    max-width: 42ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--mute);
  }
  .gs ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: s;
  }
  .gs li {
    counter-increment: s;
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    column-gap: 16px;
    padding-bottom: 28px;
  }
  .gs li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 17px;
    top: 38px;
    bottom: 6px;
    width: 1px;
    background: var(--edge);
  }
  .gs li::before {
    content: counter(s);
    grid-row: span 4;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--edge);
    border-radius: 50%;
    font: 600 15px var(--font-body);
    color: var(--teal);
  }
  .gs li h3 {
    margin: 6px 0 4px;
    font: 600 18px var(--font-body);
  }
  .gs li p {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--mute);
  }
  .gs li p code {
    font: 500 13px var(--font-mono);
    color: #cfe0ec;
  }
  .gs li.skip h3,
  .gs li.skip::before {
    color: var(--mute);
  }
  .gs .os {
    display: flex;
    gap: 4px;
    margin-bottom: 8px;
  }
  .gs .os > * {
    padding: 3px 9px;
    border-radius: 6px;
    font: 500 12px var(--font-body);
    color: var(--mute);
    text-decoration: none;
  }
  .gs .os .on {
    background: #16283a;
    color: var(--line);
  }
  .gs .os a:hover {
    color: var(--line);
  }
  .gs .cmd {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 10px 10px 10px 14px;
    background: var(--panel);
    border: 1px solid var(--edge);
    border-radius: 8px;
    font: 500 14px var(--font-mono);
    color: #cfe0ec;
  }
  .gs .cmd + .cmd {
    margin-top: 8px;
  }
  .gs .cmd::before {
    content: '$';
    color: var(--teal);
    user-select: none;
  }
  .gs .cmd code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    font: inherit;
  }
  .gs .copy-btn {
    flex: none;
    margin-left: auto;
    padding: 4px 9px;
    background: none;
    border: 1px solid var(--edge);
    border-radius: 6px;
    font: 500 12px var(--font-body);
    color: var(--mute);
    cursor: pointer;
  }
  .gs .copy-btn:hover {
    color: var(--line);
    border-color: var(--teal);
  }
  .gs .pre {
    margin: 4px 0 0;
    padding-left: 52px;
    font-size: 14px;
    color: var(--mute);
  }
  .gs .pre strong {
    color: var(--peri);
    font-weight: 600;
  }

  .gs .result {
    position: sticky;
    /* Pin below the sticky page header so the tabs stay in view. */
    top: calc(var(--header-h, 0px) + 24px);
  }
  .gs [hidden] {
    display: none !important;
  }
  .gs .file {
    background: var(--panel);
    border: 1px solid var(--edge);
    border-bottom: none;
    border-radius: 10px 10px 0 0;
  }
  .gs .tabs {
    display: flex;
    overflow-x: auto;
    /* The buttons' -1px margin would otherwise get a 1px vertical scrollbar. */
    overflow-y: hidden;
    border-bottom: 1px solid var(--edge);
  }
  .gs .tabs button {
    margin-bottom: -1px;
    padding: 11px 16px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font: 500 12.5px var(--font-mono);
    color: var(--mute);
    white-space: nowrap;
    cursor: pointer;
  }
  .gs .tabs button b {
    font-weight: 500;
  }
  .gs .tabs button[aria-selected='true'] {
    color: var(--line);
    border-bottom-color: var(--teal);
  }
  .gs .tabs button:focus-visible {
    outline-offset: -2px;
  }
  .gs .panel {
    min-height: 262px;
    overflow-x: auto;
  }
  .gs .panel pre {
    margin: 0;
    padding: 16px;
    width: max-content;
    min-width: 100%;
    background: transparent !important;
    font: 500 13px/1.7 var(--font-mono);
    tab-size: 4;
  }
  .gs .panel code {
    font: inherit;
  }
  .gs .edit {
    background: #16314a;
    border-radius: 3px;
    box-shadow: 0 0 0 2px #16314a;
  }
  .gs .window {
    overflow: hidden;
    background: #f3f7fa;
    color: #18293a;
    border-radius: 0 0 10px 10px;
    box-shadow: 0 30px 60px -20px #000a;
  }
  .gs .window .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    background: #e3eaf0;
    font-size: 12px;
    color: #6a7f91;
  }
  .gs .window .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c6d2dc;
  }
  .gs .window .bar span {
    margin-left: 8px;
  }
  .gs .window .body {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 34px 24px 38px;
  }
  .gs .window .hi {
    font: 600 24px var(--font-body);
  }
  .gs .window .btn {
    padding: 8px 18px;
    background: var(--steel);
    border-radius: 6px;
    font: 500 14px var(--font-body);
    color: #fff;
  }
  .gs .window .count {
    font-size: 13px;
    color: #6a7f91;
  }
  .gs .hint {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--mute);
  }
  .gs .hint::before {
    content: '';
    flex: none;
    width: 12px;
    height: 12px;
    background: #16314a;
    border: 1px solid #2a4f72;
    border-radius: 3px;
  }
  .gs .next {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding-top: 40px;
  }
  .gs .next a {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--teal);
    font: 600 16px var(--font-body);
    text-decoration: none;
    color: var(--line);
  }

  @media (max-width: 1100px) {
    .gs {
      padding: 64px 0 80px;
    }
    .gs .wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .gs .result {
      position: static;
    }
    .gs .next {
      padding-top: 16px;
    }
  }
  @media (max-width: 480px) {
    .gs .pre {
      padding-left: 0;
    }
  }
</style>
