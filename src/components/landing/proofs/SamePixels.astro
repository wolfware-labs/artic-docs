---
const devices = [
  { name: 'Windows', kind: 'win' },
  { name: 'macOS', kind: 'mac' },
  { name: 'Linux', kind: 'win' },
  { name: 'iOS', kind: 'phone' },
  { name: 'Android', kind: 'phone' },
];
---

<div class="same">
  <ul class="devices" role="list">
    {devices.map((d) => (
      <li class={`dev ${d.kind}`}>
        <div class={`screen ${d.kind}`} aria-hidden="true">
          {d.kind !== 'phone' && <div class="chrome"><i></i><i></i><i></i></div>}
          <div class="ui">
            <b>Sign in</b>
            <div class="f">{d.kind === 'phone' ? 'you@…' : 'you@example.com'}</div>
            <div class="p">Sign in</div>
          </div>
        </div>
        <small>{d.name}</small>
      </li>
    ))}
  </ul>
  <p class="diff"><span>goldens</span>Controls are checked against reference images in the renderer's tests.</p>
</div>

<style is:global>
  .proofs .devices {
    display: grid;
    grid-template-columns: 1.25fr 1.25fr 1.1fr 0.55fr 0.55fr;
    gap: 16px;
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .proofs .dev {
    display: grid;
    gap: 8px;
    justify-items: center;
    min-width: 0;
  }
  .proofs .dev small {
    font: 500 13px var(--font-body);
    color: var(--mute);
  }
  .proofs .screen {
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #f3f7fa;
    color: #18293a;
    box-shadow: 0 20px 40px -18px #000c;
  }
  .proofs .screen .chrome {
    display: flex;
    gap: 4px;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    background: #e1e8ee;
  }
  .proofs .screen .chrome i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c2ced8;
  }
  .proofs .screen.win .chrome {
    justify-content: flex-end;
  }
  .proofs .screen.win .chrome i {
    width: 7px;
    height: 2px;
    border-radius: 0;
  }
  .proofs .screen.phone {
    padding-top: 10px;
    border-radius: 16px;
  }
  .proofs .ui {
    display: grid;
    gap: 7px;
    padding: 16px 12px 18px;
  }
  .proofs .ui b {
    font: 600 14px var(--font-body);
    text-align: center;
  }
  .proofs .ui .f {
    height: 22px;
    padding: 0 7px;
    overflow: hidden;
    white-space: nowrap;
    border: 1px solid #c9d6e1;
    border-radius: 5px;
    background: #fff;
    font: 400 10px / 20px var(--font-body);
    color: #6f8295;
  }
  .proofs .ui .p {
    height: 24px;
    border-radius: 5px;
    background: var(--steel);
    color: #fff;
    font: 500 11px / 24px var(--font-body);
    text-align: center;
  }
  .proofs .phone .ui {
    padding: 14px 8px 26px;
  }
  .proofs .phone .ui b {
    font-size: 12px;
  }
  .proofs .diff {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 22px 0 0;
    font: 500 14px var(--font-body);
    color: var(--mute);
  }
  .proofs .diff span {
    padding: 4px 10px;
    border: 1px solid #2b5a5c;
    border-radius: 6px;
    font: 500 13px var(--font-mono);
    color: var(--teal);
  }
  @media (max-width: 640px) {
    .proofs .devices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 24px;
    }
  }
</style>
