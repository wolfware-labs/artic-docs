---
import IceBackground from './IceBackground.astro';
import HeroDemo from './HeroDemo';
---

<header class="hero">
  <IceBackground />
  <div class="container">
    <slot name="nav" />
    <div class="body">
      <div class="copy">
        <h1><span class="sr-only">artic: </span>Write the UI.<br />Rust does the rest.</h1>
        <p class="sub">
          Views in XAML, logic in Rust, one GPU renderer that draws the same pixels on Windows,
          macOS, Linux, iOS and Android.
        </p>
        <div class="btns">
          <a class="btn primary" href="#get-started">Get started</a>
          <a class="btn ghost" href="#how-it-works">How it works</a>
        </div>
      </div>
      <div class="demo">
        <HeroDemo client:visible />
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 90% at 70% 10%, #1d3550 0%, var(--bg) 60%);
    padding: 34px 0 72px;
    /* Fill the first screen so the next section stays out of view until the reader scrolls. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .container {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .body {
    display: flex;
    gap: 56px;
    align-items: center;
    margin-top: 64px;
    flex: 1;
  }
  .copy {
    position: relative;
    z-index: 2;
    flex: 0 0 470px;
    min-width: 0;
  }
  h1 {
    margin: 0 0 14px;
    font: 700 56px/1.05 var(--font-display);
    letter-spacing: -0.5px;
    color: var(--line);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sub {
    margin: 0 0 28px;
    max-width: 420px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--mute);
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 8px;
    font: 600 16px/1 var(--font-body);
    text-decoration: none;
  }
  .primary {
    background: linear-gradient(135deg, var(--teal), var(--steel));
    color: #06121c;
  }
  .ghost {
    border: 1px solid #2c4660;
    color: var(--line);
  }
  .ghost:hover {
    border-color: var(--teal);
  }
  .demo {
    position: relative;
    z-index: 1;
    flex: 1 1 0;
    min-width: 0;
  }
  @media (max-width: 1100px) {
    .body { flex-direction: column; align-items: stretch; gap: 40px; margin-top: 40px; }
    h1 { font-size: 44px; }
    .copy { flex: none; }
    .demo { flex: none; width: 100%; margin-left: 0; }
  }
</style>
