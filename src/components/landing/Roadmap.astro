---
import { loadMilestones, milestoneStatus, parseTitle } from '../../lib/milestones';
import { milestoneNotes } from '../../data/milestone-notes';

const milestones = await loadMilestones();
const firstPlanned = milestones.findIndex((m) => milestoneStatus(m) === 'planned');

const items = milestones.map((m, i) => {
  const status = milestoneStatus(m);
  const total = m.open + m.closed;
  const { code, name } = parseTitle(m.title);
  const label =
    status === 'done'
      ? 'Done'
      : status === 'in-progress'
        ? 'In progress'
        : i === firstPlanned
          ? 'Next'
          : 'Planned';
  return {
    ...m,
    status,
    code,
    name,
    label,
    total,
    percent: total === 0 ? 0 : Math.round((m.closed / total) * 100),
    note: milestoneNotes[m.number] ?? '',
  };
});
const doneShare = items.filter((m) => m.status === 'done').length;
---

<section id="roadmap" class="roadmap" aria-labelledby="roadmap-title">
  <div class="container">
    <h2 id="roadmap-title">Where artic is today.</h2>
    <p class="one">
      artic is early. These are the milestones from the spec: what works now, what comes next, and what lands before 1.0.
    </p>

    <ol class="track" style={`--done: ${doneShare}`}>
      {
        items.map((m) => (
          <li class={`m ${m.status}`} data-milestone={m.number} data-status={m.status}>
            <div class="dot" aria-hidden="true">
              <svg viewBox="0 0 32 32" focusable="false">
                {m.status === 'done' && <polygon points="16,1 31,16 16,31 1,16" fill="#6cc3c0" />}
                {m.status === 'in-progress' && (
                  <>
                    <polygon points="16,1 31,16 16,31 1,16" fill="#0f1b26" stroke="#6cc3c0" stroke-width="2" />
                    <polygon points="16,1 16,31 1,16" fill="#6cc3c0" />
                  </>
                )}
                {m.status === 'planned' && (
                  <polygon points="16,1 31,16 16,31 1,16" fill="#0f1b26" stroke="#8fa8e8" stroke-dasharray="3 3" />
                )}
              </svg>
              {m.code && <b class="code">{m.code}</b>}
            </div>
            <span class="state">{m.label}</span>
            <h3>
              <a class="ms" href={m.url}>{m.name}</a>
            </h3>
            {m.note && <p>{m.note}</p>}
            {m.status === 'in-progress' && (
              <>
                <div class="bar" role="img" aria-label={`${m.closed} of ${m.total} issues closed`}>
                  <i style={`width: ${m.percent}%`} />
                </div>
                <small class="cnt">{m.closed} of {m.total} issues</small>
              </>
            )}
          </li>
        ))
      }
    </ol>

    <div class="follow">
      <div class="newsletter"><slot name="newsletter" /></div>
      <div class="links">
        <a href="/docs/contributing/spec/technical-spec/">Read the spec</a>
        <a href="https://github.com/wolfware-labs/artic/labels/good%20first%20issue">Good first issues</a>
        <a href="https://github.com/wolfware-labs/artic">Star on GitHub</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .roadmap {
    padding: 88px 0 96px;
    border-top: 1px solid var(--edge);
  }
  .roadmap h2 {
    margin: 0 0 14px;
    font: 700 clamp(34px, 4.2vw, 52px) / 1.02 var(--font-display);
  }
  .roadmap .one {
    margin: 0 0 56px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--mute);
  }

  /* Stacked by default: a vertical rail with the diamonds on it. */
  .roadmap .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    row-gap: 28px;
    position: relative;
  }
  .roadmap .track::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 16px;
    bottom: 16px;
    width: 2px;
    background: #2a4560;
  }
  .roadmap .m {
    position: relative;
    padding-left: 52px;
    min-width: 0;
  }
  .roadmap .dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    z-index: 1;
  }
  .roadmap .dot svg {
    position: absolute;
    inset: 0;
  }
  .roadmap .code {
    position: relative;
    font: 600 12px var(--font-body);
  }
  .roadmap .done .code {
    color: #0b1620;
  }
  .roadmap h3 {
    margin: 0 0 6px;
    font: 600 16px / 1.2 var(--font-body);
  }
  .roadmap .ms {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(var(--teal), var(--teal)) 0 100% / 0 1px no-repeat;
    transition: background-size 0.2s;
  }
  .roadmap .ms:hover,
  .roadmap .ms:focus-visible {
    background-size: 100% 1px;
  }
  .roadmap .m p {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--mute);
  }
  .roadmap .state {
    display: block;
    margin-bottom: 6px;
    font: 500 12px var(--font-body);
    color: var(--mute);
  }
  .roadmap .done .state {
    color: var(--teal);
  }
  .roadmap .in-progress .state {
    color: var(--line);
  }
  .roadmap .planned .dot,
  .roadmap .planned .state,
  .roadmap .planned h3,
  .roadmap .planned p {
    opacity: 0.6;
  }
  .roadmap .planned h3:focus-within,
  .roadmap .planned h3:hover {
    opacity: 1;
  }
  .roadmap .bar {
    height: 4px;
    margin-top: 12px;
    max-width: 240px;
    overflow: hidden;
    border-radius: 2px;
    background: #24405a;
  }
  .roadmap .bar i {
    display: block;
    height: 100%;
    background: var(--teal);
  }
  .roadmap .cnt {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    color: var(--mute);
  }

  /* Wide: all nine on one horizontal track. */
  @media (min-width: 1180px) {
    .roadmap .track {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: 32px;
      row-gap: 0;
    }
    .roadmap .track::before {
      left: 0;
      right: 0;
      top: 15px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--teal) 0 calc(100% * var(--done) / 9 - 16px), #2a4560 0);
    }
    .roadmap .m {
      padding-left: 0;
    }
    .roadmap .dot {
      position: relative;
      margin-bottom: 18px;
    }
    .roadmap .in-progress::after {
      content: '';
      position: absolute;
      inset: -14px -12px -16px;
      border: 1px solid #2b5a5c;
      border-radius: 10px;
      background: #6cc3c00a;
      pointer-events: none;
    }
    .roadmap h3 {
      font-size: 15px;
    }
    .roadmap .bar {
      max-width: none;
    }
  }

  .roadmap .follow {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--edge);
  }
  .roadmap .newsletter {
    margin-right: auto;
    min-width: 0;
  }
  .roadmap .newsletter:empty {
    display: none;
  }
  .roadmap .news {
    display: grid;
    gap: 12px;
    max-width: 100%;
  }
  .roadmap .news label b {
    display: block;
    font: 600 18px var(--font-body);
  }
  .roadmap .news label span {
    color: var(--mute);
    font-size: 14px;
  }
  .roadmap .news .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .roadmap .news input[type='email'] {
    flex: 1 1 200px;
    width: 280px;
    max-width: 100%;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid var(--edge);
    border-radius: 8px;
    background: var(--panel);
    color: var(--line);
    font: 400 15px var(--font-body);
  }
  .roadmap .news input[type='email']:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 1px;
  }
  .roadmap .news button {
    padding: 10px 18px;
    border: 0;
    border-radius: 8px;
    background: var(--teal);
    color: #06121c;
    font: 600 15px var(--font-body);
    cursor: pointer;
  }
  .roadmap .news button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .roadmap .news button:focus-visible {
    outline: 2px solid var(--line);
    outline-offset: 2px;
  }
  .roadmap .news .msg {
    margin: 0;
    font-size: 14px;
  }
  /* Stays rendered so screen readers announce text when it appears; it only
     gives back the grid gap while empty. */
  .roadmap .news .msg:empty {
    margin-top: -12px;
  }
  .roadmap .news .msg.done {
    color: var(--teal);
  }
  .roadmap .news .msg.failed {
    color: var(--line);
  }
  .roadmap .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-left: auto;
    padding-bottom: 10px;
  }
  .roadmap .links a {
    border-bottom: 1px solid var(--teal);
    font: 600 15px var(--font-body);
    color: var(--line);
    text-decoration: none;
  }
</style>
