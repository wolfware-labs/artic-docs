---
// Faceted low-poly ice, full-bleed behind the hero column.
---

<svg
  class="ice"
  viewBox="0 0 1000 440"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <polygon points="0,440 160,260 330,440" fill="#16304a"></polygon>
  <polygon points="160,260 420,150 330,440" fill="#1b3a58"></polygon>
  <polygon points="420,150 640,300 330,440" fill="#13283d"></polygon>
  <polygon points="640,300 820,170 1000,330 1000,440 330,440" fill="#1a3552"></polygon>
  <polygon points="0,440 0,290 160,260" fill="#122436"></polygon>
  <polygon points="420,150 820,170 640,300" fill="#21466a"></polygon>
  <polygon points="820,170 1000,90 1000,330" fill="#1c3b5a"></polygon>
  <polygon points="0,290 0,120 160,260" fill="#101f2e"></polygon>
</svg>

<style>
  .ice {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.6;
    pointer-events: none;
  }
</style>
