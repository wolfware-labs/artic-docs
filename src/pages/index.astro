---
import Landing from '../layouts/Landing.astro';
import GettingStarted from '../components/landing/GettingStarted.astro';
import Proofs from '../components/landing/Proofs.astro';
import Roadmap from '../components/landing/Roadmap.astro';
import Newsletter from '../components/landing/Newsletter';
import { newsletterAction } from '../lib/newsletter';
import ExplodedStack from '../components/landing/exploded/ExplodedStack';
const action = newsletterAction(import.meta.env);
---

<Landing>
  <section id="how-it-works" aria-labelledby="how-it-works-title">
    <ExplodedStack client:visible={{ rootMargin: '400px' }} />
  </section>
  <GettingStarted />
  <Proofs />
  <Roadmap>
    {action && <Newsletter slot="newsletter" action={action} client:visible />}
  </Roadmap>
</Landing>
