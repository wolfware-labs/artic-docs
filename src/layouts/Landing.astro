---
import '../styles/landing.css';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import Footer from '../components/landing/Footer.astro';
import StickyHeader from '../components/landing/StickyHeader.astro';
import {
  REPOSITORY,
  SHARE_IMAGE_ALT,
  SHARE_IMAGE_HEIGHT,
  SHARE_IMAGE_WIDTH,
  SITE_NAME,
} from '../lib/seo.mjs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'artic: a cross-platform UI framework for Rust',
  // Same text as the hero's subtitle.
  description = 'Views in XAML, logic in Rust, and one GPU renderer that draws the same pixels on every platform.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Versioned in astro.config.mjs so link previews refetch the card when it changes.
const image = import.meta.env.SHARE_IMAGE_URL;
const structured = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: SITE_NAME,
  description,
  url: canonical,
  codeRepository: REPOSITORY,
  programmingLanguage: 'Rust',
  license: [`${REPOSITORY}/blob/main/LICENSE-MIT`, `${REPOSITORY}/blob/main/LICENSE-APACHE`],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/brand/artic-logo.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={SHARE_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>
  <body id="top">
    <StickyHeader />
    <Hero>
      <Nav slot="nav" />
    </Hero>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
