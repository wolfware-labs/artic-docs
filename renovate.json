{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "github-actions", "dockerfile"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "The site is built from these, so a bump has to cut a release to ship.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "The image runs on this base, so a bump has to cut a release to ship.",
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "fix"
    }
  ]
}
